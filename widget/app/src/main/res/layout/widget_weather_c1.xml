<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/c1_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout android:id="@+id/c1_box" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/ripple_round" android:orientation="vertical" android:paddingLeft="4dp" android:paddingRight="4dp">
        <TextView android:id="@+id/c1_place" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/c1_desc" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/c1_main" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="4dp">
        <ImageView android:id="@+id/c1_icon" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/w_cloud" />
        <TextView android:id="@+id/c1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="4dp" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="26sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="8dp" android:orientation="vertical">
            <TextView android:id="@+id/c1_hi" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="12sp" />
            <TextView android:id="@+id/c1_lo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/c1_info" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="5" android:paddingLeft="4dp" android:paddingRight="4dp"
        android:textColor="#B3FFFFFF" android:textSize="11sp" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp" android:background="#2EFFFFFF" />

    <LinearLayout android:id="@+id/c1_fc" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingLeft="4dp" android:paddingRight="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="2dp">
            <TextView android:id="@+id/c1_f1_d" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/c1_f1_i" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_marginRight="4dp" android:src="@drawable/w_cloud" />
            <TextView android:id="@+id/c1_f1_t" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="2dp">
            <TextView android:id="@+id/c1_f2_d" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/c1_f2_i" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_marginRight="4dp" android:src="@drawable/w_cloud" />
            <TextView android:id="@+id/c1_f2_t" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="2dp">
            <TextView android:id="@+id/c1_f3_d" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:maxLines="1" android:textColor="#B3FFFFFF" android:textSize="11sp" />
            <ImageView android:id="@+id/c1_f3_i" android:layout_width="16dp" android:layout_height="16dp"
                android:layout_marginRight="4dp" android:src="@drawable/w_cloud" />
            <TextView android:id="@+id/c1_f3_t" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
