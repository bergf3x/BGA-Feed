<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/glass_fill" />

    <ImageView
        android:id="@+id/bg_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/glass_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="14dp"
        android:paddingRight="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/w_cloud" />

            <LinearLayout
                android:id="@+id/w_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:background="@drawable/ripple_round"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Berchtesgaden ▾"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Wetter lädt …"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="–"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_hi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/w_lo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btn_refresh"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/ripple_circle"
                    android:padding="5dp"
                    android:src="@drawable/ic_refresh" />

                <ImageView
                    android:id="@+id/btn_settings"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/ripple_circle"
                    android:padding="5dp"
                    android:src="@drawable/ic_tune" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fc_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2EFFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fc1_d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/fc1_i"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="3dp"
                    android:layout_marginRight="3dp"
                    android:src="@drawable/w_cloud" />

                <TextView
                    android:id="@+id/fc1_t"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fc2_d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/fc2_i"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="3dp"
                    android:layout_marginRight="3dp"
                    android:src="@drawable/w_cloud" />

                <TextView
                    android:id="@+id/fc2_t"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fc3_d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/fc3_i"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="3dp"
                    android:layout_marginRight="3dp"
                    android:src="@drawable/w_cloud" />

                <TextView
                    android:id="@+id/fc3_t"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2EFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_p"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/p0"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginRight="4dp"
                android:layout_weight="0.75"
                android:background="@drawable/chip_bg">

                <ImageView
                    android:id="@+id/p0_on"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/chip_on"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/p0_t"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/p1"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/chip_bg">

                <ImageView
                    android:id="@+id/p1_on"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/chip_on"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/p1_t"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/p2"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1.4"
                android:background="@drawable/chip_bg">

                <ImageView
                    android:id="@+id/p2_on"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/chip_on"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/p2_t"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/p3"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginRight="4dp"
                android:layout_weight="0.9"
                android:background="@drawable/chip_bg">

                <ImageView
                    android:id="@+id/p3_on"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/chip_on"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/p3_t"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/p4"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginRight="4dp"
                android:layout_weight="0.9"
                android:background="@drawable/chip_bg">

                <ImageView
                    android:id="@+id/p4_on"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/chip_on"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/p4_t"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="4dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/empty_text"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
