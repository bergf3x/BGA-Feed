<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="16dp"
            android:background="#FF6B6B70">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="12dp">

                <ImageView
                    android:id="@+id/prev_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/glass_fill" />

                <ImageView
                    android:id="@+id/prev_border"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/glass_border" />

                <TextView
                    android:id="@+id/prev_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:text="Bergwacht rettet verletzte Wanderin im Lattengebirge"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/lbl_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/sb_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="99" />

        <TextView
            android:id="@+id/lbl_tx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/sb_tx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="99" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Speichern" />
    </LinearLayout>
</ScrollView>
