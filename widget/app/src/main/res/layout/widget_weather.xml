<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="1"
        android:scaleType="fitXY"
        android:src="@drawable/glass_fill" />

    <ImageView
        android:id="@+id/bg_fill_l"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/bg_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/glass_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp">


        <!-- Kopfzeile wie in der App: Name links, Knoepfe rechts (nicht mehr in der Wetterzeile) -->
        <LinearLayout
            android:id="@+id/head_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="BGL Wetter &amp; News"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_wcam"
                android:layout_marginRight="6dp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/btn_round"
                android:contentDescription="Live Webcams"
                android:padding="8dp"
                android:src="@drawable/ic_cam" />
            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/btn_round"
                android:contentDescription="Aktualisieren"
                android:padding="8dp"
                android:src="@drawable/ic_refresh" />

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_marginLeft="6dp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/btn_round"
                android:contentDescription="Einstellungen"
                android:padding="8dp"
                android:src="@drawable/ic_tune" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/w_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/w_tint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="1"
            android:scaleType="fitXY"
            android:src="@drawable/w_tint" />

        <ImageView
            android:id="@+id/w_tint_l"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingTop="4dp"
            android:paddingRight="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/w_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/w_cloud" />

            <LinearLayout
                android:id="@+id/w_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:background="@drawable/ripple_round"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Berchtesgaden ▾"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Wetter lädt …"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="–"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/w_hilo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_hi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/w_lo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/w_warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:textColor="#FFFFB74D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
            android:id="@+id/w_info"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
                        android:ellipsize="end"
            android:maxLines="6"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fc_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2EFFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/fc1_d"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="#B3FFFFFF"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/fc1_i"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginLeft="3dp"
                            android:layout_marginRight="3dp"
                            android:src="@drawable/w_cloud" />

                        <TextView
                            android:id="@+id/fc1_t"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/fc1_bar"
                        android:layout_width="56dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bar_track">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/bar_fill" />
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/fc2_d"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="#B3FFFFFF"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/fc2_i"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginLeft="3dp"
                            android:layout_marginRight="3dp"
                            android:src="@drawable/w_cloud" />

                        <TextView
                            android:id="@+id/fc2_t"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/fc2_bar"
                        android:layout_width="56dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bar_track">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/bar_fill" />
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/fc3_d"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="#B3FFFFFF"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/fc3_i"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginLeft="3dp"
                            android:layout_marginRight="3dp"
                            android:src="@drawable/w_cloud" />

                        <TextView
                            android:id="@+id/fc3_t"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/fc3_bar"
                        android:layout_width="56dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bar_track">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/bar_fill" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2EFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:orientation="horizontal"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/btn_search"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/ripple_circle"
                    android:padding="7dp"
                    android:src="@drawable/ic_search" />
                <ImageView
                    android:id="@+id/btn_saved"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/ripple_circle"
                    android:padding="7dp"
                    android:src="@drawable/ic_bookmark" />
                <ImageView
                    android:id="@+id/btn_cam"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/ripple_circle"
                    android:padding="7dp"
                    android:src="@drawable/ic_cam" />
            </LinearLayout>
            <TextView
            android:id="@+id/w_stand"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:ellipsize="end"
                        android:gravity="right"
            android:maxLines="1"
            android:paddingRight="6dp"
            android:textColor="#80FFFFFF"
            android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
